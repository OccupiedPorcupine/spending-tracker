# Lives at /home/maize/spend/.env on mysites (mode 600). Never commit the real file.

# Which sheet to write to: "dev" (SHEET_ID_DEV) until go-live, then "live" (SHEET_ID).
SHEET_TARGET=dev
# The IDs are not in git on purpose: this repo is public, and a sheet ID is enough to open a link-shared sheet.
SHEET_ID=
SHEET_ID_DEV=

# Service account key on the host (chmod 600, owner maize), mounted read-only into the container.
GOOGLE_SA_FILE_HOST=/home/maize/spend/secrets/google-sa.json

# OpenAI (milestone 2). Use a project key from a project with a monthly budget.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Sessions end after this many days without use.
SESSION_IDLE_DAYS=30

PUBLIC_HOST=spending.munyau.space
# Host port for the app container (always bound to 127.0.0.1).
APP_PORT=8001
BACKUP_DIR=/home/maize/spend/backups
