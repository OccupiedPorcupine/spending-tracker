# Spend's site block, imported by gym's Caddy from /home/maize/caddy-sites.
# deploy.sh fills in __PUBLIC_HOST__ and __APP_PORT__ from the server's .env.
# Same tailnet-only setup as gym: Caddy binds only mysites' Tailscale IP (global default_bind),
# and certificates come from DNS-01.
__PUBLIC_HOST__ {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	# Drop anything that is not from a tailnet address, without a response.
	@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @outside

	encode zstd gzip
	reverse_proxy 127.0.0.1:__APP_PORT__
}
