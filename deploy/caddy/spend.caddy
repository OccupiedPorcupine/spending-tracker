# Spend: imported by gym's Caddy (see README "Reverse proxy"). Same tailnet-only setup as gym:
# Caddy binds only mysites' Tailscale IP (global default_bind), certificates come from DNS-01.
spend.munyau.space {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	# Drop anything that is not from a tailnet address, without a response.
	@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @outside

	encode zstd gzip
	reverse_proxy 127.0.0.1:__APP_PORT__
}
